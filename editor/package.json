{
  "name": "editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync && node scripts/patch-native.mjs",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "android:run": "npm run cap:sync && cap run android",
    "ios:run": "npm run cap:sync && cap run ios",
    "assets": "capacitor-assets generate --iconBackgroundColor #D3E3FD --splashBackgroundColor #D3E3FD"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@google/genai": "^2.28.0",
    "@hookform/resolvers": "^5.4.0",
    "@iconify/react": "^5.2.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "@types/jszip": "^3.4.0",
    "@types/three": "^0.185.4",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.28.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.1.5"
  }
}
