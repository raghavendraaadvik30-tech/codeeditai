VITE_API_URL=https://api.example.com

# Gemini AI API Key
# Add your Google Gemini API key to enable live AI Authoring, Chat & Clinical Drafting.
# Get an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Google Fonts Developer API Key (Optional)
# Leave empty to use the built-in curated list of standard system fonts and top Google Fonts.
# To load all 1,500+ fonts from the Google Fonts directory:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Enable "Web Fonts Developer API"
# 3. Create an API Key and paste it below:
VITE_GOOGLE_FONTS_API_KEY=

# ---------------------------------------------------------------
# Mobile app (Capacitor) build
# ---------------------------------------------------------------
# Create a file named .env.mobile (git-ignored) with the HTTPS URL of your
# deployed backend. "localhost" does NOT work on a phone, because it points
# at the phone itself.
#   VITE_API_URL=https://api.your-domain.com
# For testing against a dev machine on the same Wi-Fi, use its LAN IP, e.g.
#   VITE_API_URL=http://192.168.1.20:8088
# (plain http is blocked on iOS unless allowed in Info.plist, see README.)
