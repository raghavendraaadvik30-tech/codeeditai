VITE_API_URL=https://api.example.com

# Gemini AI API Key
# Add your Google Gemini API key to enable live AI Authoring, Chat & Clinical Drafting.
# Get an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Google Fonts Developer API Key (Optional)
# Leave empty to use the built-in curated list of standard system fonts and top Google Fonts.
# To load all 1,500+ fonts from the Google Fonts directory:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Enable "Web Fonts Developer API"
# 3. Create an API Key and paste it below:
VITE_GOOGLE_FONTS_API_KEY=

# ---------------------------------------------------------------
# Mobile app (Capacitor) build -> see MOBILE.md
# ---------------------------------------------------------------
# Put VITE_API_URL in a file named .env.mobile (git-ignored). "localhost" is
# rejected because on a phone it points at the phone itself. Examples:
#   VITE_API_URL=https://api.your-domain.com   (deployed, needed for stores)
#   VITE_API_URL=http://192.168.31.240:8088    (your PC's Wi-Fi IP)
#   VITE_API_URL=http://10.0.2.2:8088          (Android emulator -> your PC)

# Public address of the web app. Used in links that are sent to other people
# (user invitation emails). Required for the mobile app, whose own address is
# https://localhost / capacitor://localhost. Example:
#   VITE_PUBLIC_APP_URL=https://app.your-domain.com
VITE_PUBLIC_APP_URL=
